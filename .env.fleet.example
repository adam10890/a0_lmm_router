# a0_lmm_router Fleet Manager example environment.
# Copy to .env.fleet and adjust paths/secrets before running compose.fleet.yml.

OBSERVER_HOST=0.0.0.0
OBSERVER_PORT=9000
A0_LMM_ROUTER_CONFIG=/a0/usr/plugins/a0_lmm_router/conf/llama_cpp_servers.yaml

# Required for public/non-local binds.
A0_LMM_ROUTER_API_KEY=change-me

# SQLite state path inside the fleet-manager container.
A0_FLEET_STATE_DB=/data/fleet_state.sqlite3

# v1 admission control. Running work is not preempted.
A0_FLEET_MAX_ACTIVE=1
A0_FLEET_MAX_QUEUE=32

# Optional image override for the Python runtime.
A0_FLEET_MANAGER_IMAGE=agent0ai/agent-zero:latest

# Optional for MCP clients running outside this service.
# A0_FLEET_MANAGER_BASE_URL=http://127.0.0.1:9000
